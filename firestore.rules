rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules.
// This is the REAL protection layer — the React ProtectedRoute only hides
// pages in the UI, it can't stop a direct request to the database.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isSeller() {
      return isSignedIn() && myRole() == 'seller';
    }

    // users/{uid} — everyone can read public profile info, but only the
    // owner or an admin can write, and only an admin can change role/status.
    //
    // NOTE: a match block does NOT cascade to sub-collections. Anything under
    // users/{uid}/... needs its own nested match, or it falls through to the
    // default deny. Keep this in sync with src/services/wishlist.js.
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();

      // users/{uid}/wishlist/{productId} — the wishlist is stored as a
      // sub-collection, one doc per product, so the product id is the doc id
      // and toggling is a plain setDoc/deleteDoc. Private to the owner.
      match /wishlist/{productId} {
        allow read, write: if isOwner(uid);
      }
    }

    // products/{id} — public read (it's a storefront), write restricted to
    // the seller who owns it or an admin.
    match /products/{productId} {
      allow read: if true;
      allow create: if isSeller() && request.resource.data.sellerId == request.auth.uid;
      // A buyer may decrement stock during checkout, and signed-in users may update rating aggregates when reviewing.
      allow update: if isAdmin() ||
        (isSeller() && resource.data.sellerId == request.auth.uid) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'ratingCount']));
      allow delete: if isAdmin() ||
        (isSeller() && resource.data.sellerId == request.auth.uid);
    }

    // categories/{id} — public read, admin-managed.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // carts/{uid} — private to the owning user.
    match /carts/{uid} {
      allow read, write: if isOwner(uid);
    }

    // wishlists/{uid} — private to the owning user.
    match /wishlists/{uid} {
      allow read, write: if isOwner(uid);
    }

    // orders/{id} — the buyer, the seller(s) involved, and admins can read.
    // Signed-in buyers or guests may create pending COD orders; only sellers/admins can update.
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid) ||
        (isSeller() && resource.data.sellerId == request.auth.uid);
      allow create: if request.resource.data.keys().hasAll([
          'userId', 'sellerId', 'sellerName', 'items', 'buyer', 'shippingAddress',
          'paymentMethod', 'status', 'subtotal', 'total', 'currency', 'createdAt'
        ]) && request.resource.data.sellerId is string &&
        request.resource.data.items is list && request.resource.data.items.size() > 0 &&
        request.resource.data.buyer is map &&
        request.resource.data.buyer.keys().hasAll(['name', 'email', 'phone']) &&
        request.resource.data.shippingAddress is map &&
        request.resource.data.shippingAddress.keys().hasAll(['address', 'city', 'postalCode', 'country']) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.paymentMethod == 'cash_on_delivery' &&
        request.resource.data.total is number && request.resource.data.total >= 0 &&
        ((isSignedIn() && request.resource.data.userId == request.auth.uid) ||
          (!isSignedIn() && request.resource.data.userId == null));
      allow update: if isAdmin() ||
        (isSeller() && resource.data.sellerId == request.auth.uid);
    }

    // reviews/{id} — public read, only the review's author can write it.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // promoCodes/{code} — public read (so checkout can validate a code),
    // admin-managed; timesUsed may be incremented upon checkout.
    match /promoCodes/{code} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timesUsed']);
    }
  }
}
